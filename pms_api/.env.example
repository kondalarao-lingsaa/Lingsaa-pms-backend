# Copy to .env and fill in. Never commit .env.

# development | production  (production refuses to start with the dev auth shortcuts below switched on)
ENVIRONMENT=development
LOG_LEVEL=INFO

DB_SERVER=192.168.1.99
DB_NAME=lingsaa_pms
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_TRUSTED_CONNECTION=False
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Must be the same secret the MASTER service signs its login tokens with.
JWT_SECRET=your_jwt_secret
JWT_ALGORITHM=HS256
# Keep these safe values. Only for local development (never on a server anyone else can reach) may they be
# switched to JWT_ENFORCE_SIGNATURE=False / ALLOW_TENANT_FROM_QUERY=True: then anyone can sign in as anyone.
JWT_ENFORCE_SIGNATURE=True
ALLOW_TENANT_FROM_QUERY=False

# Comma-separated frontend addresses allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
MASTER_SERVICE_API_URL=http://127.0.0.1:8009

# Uploaded documents (folder must be backed up) and the largest file allowed
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=15
